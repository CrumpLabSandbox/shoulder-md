{
  "name": "shoulder-md",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A Markdown editor with Word-style tracked changes and comments.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ia-writer-duo": "^5.3.0",
    "@fontsource/ia-writer-mono": "^5.3.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "dompurify": "^3.4.0",
    "idb": "^8.0.3",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  }
