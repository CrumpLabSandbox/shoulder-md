{
  "name": "shoulder-md",
  "productName": "Shoulder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A Markdown editor with Word-style tracked changes and comments.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "vite build && electron .",
    "app:dev": "SHOULDER_DEV_URL=http://localhost:5173 electron .",
    "app:build": "vite build && electron-builder --mac dir",
    "icon": "node scripts/make-icon.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ia-writer-duo": "^5.3.0",
    "@fontsource/ia-writer-mono": "^5.3.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.7.2",
    "docx": "^9.8.1",
    "dompurify": "^3.4.0",
    "idb": "^8.0.3",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.crumplab.shoulder-md",
    "productName": "Shoulder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      ".claude/skills/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "author": "Matt Crump"
}
